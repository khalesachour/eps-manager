<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des classes - Admin EPS Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #2c3e50 0%, #1a2632 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 10px;
            transition: all 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .card { border: none; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); }
        .btn-primary { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 p-0">
                <div class="sidebar p-3">
                    <h4 class="text-white text-center mb-4">
                        <i class="bi bi-trophy-fill"></i> EPS Manager
                    </h4>
                    <hr class="bg-white">
                    <p class="text-white-50 text-center small">
                        <i class="bi bi-person-circle"></i> <%= user.full_name %><br>
                        <span class="badge bg-danger">Administrateur</span>
                    </p>
                    <hr class="bg-white">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Tableau de bord
                        </a>
                        <a class="nav-link" href="/admin/teachers">
                            <i class="bi bi-person-badge me-2"></i> Enseignants
                        </a>
                        <a class="nav-link" href="/admin/users">
                            <i class="bi bi-people me-2"></i> Comptes utilisateurs
                        </a>
                        <a class="nav-link active" href="/admin/classes">
                            <i class="bi bi-building me-2"></i> Classes
                        </a>
                        <a class="nav-link" href="/admin/aps">
                            <i class="bi bi-trophy me-2"></i> Activités sportives
                        </a>
                        <hr class="bg-white">
                        <a class="nav-link text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1"><i class="bi bi-building me-2"></i> Gestion des classes</h2>
                        <p class="text-muted mb-0">Créez, modifiez ou supprimez les classes</p>
                    </div>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createClassModal">
                        <i class="bi bi-plus-lg me-1"></i> Nouvelle classe
                    </button>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle me-2"></i><%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nom de la classe</th>
                                        <th>Année scolaire</th>
                                        <th>Enseignant</th>
                                        <th>Nb élèves</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (classes.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">
                                                <i class="bi bi-building fs-1 d-block mb-2"></i>
                                                Aucune classe enregistrée
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% classes.forEach(function(c) { %>
                                        <tr>
                                            <td><strong><%= c.name %></strong></td>
                                            <td><span class="badge bg-light text-dark border"><%= c.academic_year %></span></td>
                                            <td>
                                                <% if (c.teacher_name) { %>
                                                    <i class="bi bi-person-badge text-primary me-1"></i><%= c.teacher_name %>
                                                <% } else { %>
                                                    <span class="text-muted">Non assigné</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="badge bg-info text-dark">
                                                    <i class="bi bi-people me-1"></i><%= c.student_count %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-sm btn-outline-primary" title="Modifier"
                                                        data-bs-toggle="modal" data-bs-target="#editClassModal"
                                                        data-classid="<%= c.id %>"
                                                        data-name="<%= c.name %>"
                                                        data-year="<%= c.academic_year %>"
                                                        data-teacher="<%= c.teacher_id || '' %>">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <% if (c.student_count === 0) { %>
                                                    <form action="/admin/classes/delete/<%= c.id %>" method="POST" style="display:inline;"
                                                        onsubmit="return confirm('Supprimer la classe <%= c.name %> ?')">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                    <% } else { %>
                                                        <button class="btn btn-sm btn-outline-secondary" disabled title="Impossible de supprimer (contient des élèves)">
                                                            <i class="bi bi-lock"></i>
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Créer une classe -->
    <div class="modal fade" id="createClassModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/admin/classes/create" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-building me-2"></i>Nouvelle classe</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nom de la classe <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" placeholder="Ex: 3ème A" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Année scolaire</label>
                            <input type="text" name="academic_year" class="form-control" value="<%= new Date().getFullYear() %>" placeholder="2025">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Enseignant responsable</label>
                            <select name="teacher_id" class="form-select">
                                <option value="">— Non assigné —</option>
                                <% teachers.forEach(function(t) { %>
                                    <option value="<%= t.id %>"><%= t.full_name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Créer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Modifier une classe -->
    <div class="modal fade" id="editClassModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="editClassForm" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Modifier la classe</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nom de la classe <span class="text-danger">*</span></label>
                            <input type="text" name="name" id="editClassName" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Année scolaire</label>
                            <input type="text" name="academic_year" id="editClassYear" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Enseignant responsable</label>
                            <select name="teacher_id" id="editClassTeacher" class="form-select">
                                <option value="">— Non assigné —</option>
                                <% teachers.forEach(function(t) { %>
                                    <option value="<%= t.id %>"><%= t.full_name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const editModal = document.getElementById('editClassModal');
        editModal.addEventListener('show.bs.modal', function(event) {
            const btn = event.relatedTarget;
            document.getElementById('editClassName').value = btn.getAttribute('data-name');
            document.getElementById('editClassYear').value = btn.getAttribute('data-year');
            document.getElementById('editClassTeacher').value = btn.getAttribute('data-teacher');
            document.getElementById('editClassForm').action = '/admin/classes/edit/' + btn.getAttribute('data-classid');
        });
    </script>
</body>
</html>
