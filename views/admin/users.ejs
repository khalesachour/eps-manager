<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comptes utilisateurs - Admin EPS Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #2c3e50 0%, #1a2632 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 10px;
            transition: all 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .card { border: none; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); }
        .badge-admin { background: #dc3545; }
        .badge-teacher { background: #667eea; }
        .badge-student { background: #43e97b; color: #065f46; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 p-0">
                <div class="sidebar p-3">
                    <h4 class="text-white text-center mb-4">
                        <i class="bi bi-trophy-fill"></i> EPS Manager
                    </h4>
                    <hr class="bg-white">
                    <p class="text-white-50 text-center small">
                        <i class="bi bi-person-circle"></i> <%= user.full_name %><br>
                        <span class="badge bg-danger">Administrateur</span>
                    </p>
                    <hr class="bg-white">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Tableau de bord
                        </a>
                        <a class="nav-link" href="/admin/teachers">
                            <i class="bi bi-person-badge me-2"></i> Enseignants
                        </a>
                        <a class="nav-link active" href="/admin/users">
                            <i class="bi bi-people me-2"></i> Comptes utilisateurs
                        </a>
                        <a class="nav-link" href="/admin/classes">
                            <i class="bi bi-building me-2"></i> Classes
                        </a>
                        <a class="nav-link" href="/admin/aps">
                            <i class="bi bi-trophy me-2"></i> Activités sportives
                        </a>
                        <hr class="bg-white">
                        <a class="nav-link text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1"><i class="bi bi-people-fill me-2"></i> Gestion des comptes utilisateurs</h2>
                        <p class="text-muted mb-0">Consultez, activez/désactivez ou réinitialisez les mots de passe</p>
                    </div>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle me-2"></i><%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nom complet</th>
                                        <th>Identifiant</th>
                                        <th>Rôle</th>
                                        <th>Classe</th>
                                        <th>Statut</th>
                                        <th>Créé le</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (users.length === 0) { %>
                                        <tr>
                                            <td colspan="7" class="text-center py-4 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                Aucun utilisateur enregistré
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% users.forEach(function(u) { %>
                                        <tr>
                                            <td><strong><%= u.full_name %></strong></td>
                                            <td><code><%= u.username %></code></td>
                                            <td>
                                                <% if (u.role === 'admin') { %>
                                                    <span class="badge badge-admin">Admin</span>
                                                <% } else if (u.role === 'teacher') { %>
                                                    <span class="badge badge-teacher">Enseignant</span>
                                                <% } else { %>
                                                    <span class="badge badge-student">Élève</span>
                                                <% } %>
                                            </td>
                                            <td><%= u.class_name || '<span class="text-muted">—</span>' %></td>
                                            <td>
                                                <% if (u.is_active) { %>
                                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Actif</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle me-1"></i>Inactif</span>
                                                <% } %>
                                            </td>
                                            <td><small><%= new Date(u.created_at).toLocaleDateString('fr-FR') %></small></td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <% if (u.role !== 'admin') { %>
                                                        <!-- Toggle Actif/Inactif -->
                                                        <form action="/admin/users/toggle/<%= u.id %>" method="POST" style="display:inline;">
                                                            <button type="submit" class="btn btn-sm <%= u.is_active ? 'btn-outline-warning' : 'btn-outline-success' %>" title="<%= u.is_active ? 'Désactiver' : 'Activer' %>">
                                                                <i class="bi <%= u.is_active ? 'bi-slash-circle' : 'bi-check-circle' %>"></i>
                                                            </button>
                                                        </form>
                                                        <!-- Reset password -->
                                                        <button class="btn btn-sm btn-outline-primary" title="Réinitialiser le mot de passe"
                                                            data-bs-toggle="modal" data-bs-target="#resetPwdModal"
                                                            data-userid="<%= u.id %>" data-username="<%= u.full_name %>">
                                                            <i class="bi bi-key"></i>
                                                        </button>
                                                        <!-- Supprimer -->
                                                        <form action="/admin/users/delete/<%= u.id %>" method="POST" style="display:inline;"
                                                            onsubmit="return confirm('Supprimer le compte de <%= u.full_name %> ? Cette action est irréversible.')">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    <% } else { %>
                                                        <span class="text-muted small">Protégé</span>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Reset Password -->
    <div class="modal fade" id="resetPwdModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="" method="POST" id="resetPwdForm">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-key me-2"></i>Réinitialiser le mot de passe</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Nouveau mot de passe pour <strong id="resetUsername"></strong> :</p>
                        <input type="password" name="new_password" class="form-control" placeholder="Nouveau mot de passe" required minlength="4">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Réinitialiser</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const resetModal = document.getElementById('resetPwdModal');
        resetModal.addEventListener('show.bs.modal', function(event) {
            const btn = event.relatedTarget;
            const userId = btn.getAttribute('data-userid');
            const username = btn.getAttribute('data-username');
            document.getElementById('resetUsername').textContent = username;
            document.getElementById('resetPwdForm').action = '/admin/users/reset-password/' + userId;
        });
    </script>
</body>
</html>
