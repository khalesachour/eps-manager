<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - EPS Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #2c3e50 0%, #1a2632 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 10px;
            transition: all 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.12); }
        .stat-card { border-left: 4px solid; }
        .stat-card.teachers { border-color: #667eea; }
        .stat-card.students { border-color: #43e97b; }
        .stat-card.classes { border-color: #f093fb; }
        .stat-card.aps { border-color: #f5a623; }
        .btn-menu {
            display: block;
            width: 100%;
            padding: 20px;
            border-radius: 15px;
            border: 2px solid transparent;
            text-align: center;
            color: #2c3e50;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-menu:hover { border-color: currentColor; color: inherit; transform: translateY(-2px); }
        .btn-menu .bi { font-size: 2.5rem; display: block; margin-bottom: 10px; }
        .menu-teachers { background: linear-gradient(135deg, #e0e7ff, #c7d2fe); color: #4338ca; }
        .menu-users { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #065f46; }
        .menu-classes { background: linear-gradient(135deg, #fce7f3, #fbcfe8); color: #9d174d; }
        .menu-aps { background: linear-gradient(135deg, #fef3c7, #fde68a); color: #92400e; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 p-0">
                <div class="sidebar p-3">
                    <h4 class="text-white text-center mb-4">
                        <i class="bi bi-trophy-fill"></i> EPS Manager
                    </h4>
                    <hr class="bg-white">
                    <p class="text-white-50 text-center small">
                        <i class="bi bi-person-circle"></i> <%= user.full_name %><br>
                        <span class="badge bg-danger">Administrateur</span>
                    </p>
                    <hr class="bg-white">
                    <nav class="nav flex-column">
                        <a class="nav-link active" href="/admin/dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Tableau de bord
                        </a>
                        <a class="nav-link" href="/admin/teachers">
                            <i class="bi bi-person-badge me-2"></i> Enseignants
                        </a>
                        <a class="nav-link" href="/admin/users">
                            <i class="bi bi-people me-2"></i> Comptes utilisateurs
                        </a>
                        <a class="nav-link" href="/admin/classes">
                            <i class="bi bi-building me-2"></i> Classes
                        </a>
                        <a class="nav-link" href="/admin/aps">
                            <i class="bi bi-trophy me-2"></i> Activités sportives
                        </a>
                        <hr class="bg-white">
                        <a class="nav-link text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <h2 class="mb-1"><i class="bi bi-speedometer2 me-2"></i> Tableau de bord</h2>
                <p class="text-muted mb-4">Bienvenue, <%= user.full_name %> !</p>

                <!-- Statistiques -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card teachers p-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person-badge fs-2 text-primary me-3"></i>
                                <div>
                                    <div class="fs-4 fw-bold"><%= stats.teachers %></div>
                                    <div class="text-muted small">Enseignants</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card students p-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-mortarboard fs-2 text-success me-3"></i>
                                <div>
                                    <div class="fs-4 fw-bold"><%= stats.students %></div>
                                    <div class="text-muted small">Élèves</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card classes p-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-building fs-2 text-danger me-3"></i>
                                <div>
                                    <div class="fs-4 fw-bold"><%= stats.classes %></div>
                                    <div class="text-muted small">Classes</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card aps p-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-trophy fs-2 text-warning me-3"></i>
                                <div>
                                    <div class="fs-4 fw-bold"><%= stats.aps %></div>
                                    <div class="text-muted small">Activités sportives</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Menu de navigation -->
                <h5 class="mb-3 text-muted">Gestion rapide</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <a href="/admin/teachers" class="btn-menu menu-teachers">
                            <i class="bi bi-person-badge"></i>
                            Gérer les enseignants
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="/admin/users" class="btn-menu menu-users">
                            <i class="bi bi-people"></i>
                            Gérer les comptes utilisateurs
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="/admin/classes" class="btn-menu menu-classes">
                            <i class="bi bi-building"></i>
                            Gérer les classes
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="/admin/aps" class="btn-menu menu-aps">
                            <i class="bi bi-trophy"></i>
                            Configurer les activités sportives
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>