<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Espace - EPS Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #2c3e50 0%, #1a2632 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 10px;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        .welcome-banner {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            padding: 30px;
            color: white;
            margin-bottom: 30px;
        }
        .note-good { color: #28a745; font-weight: bold; }
        .note-medium { color: #ffc107; font-weight: bold; }
        .note-bad { color: #dc3545; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 p-0">
                <div class="sidebar p-3">
                    <h4 class="text-white text-center mb-4">
                        <i class="bi bi-trophy-fill"></i> EPS Manager
                    </h4>
                    <hr class="bg-white">
                    <p class="text-white-50 text-center small">
                        <i class="bi bi-person-circle"></i> <%= user.full_name %><br>
                        <span class="badge bg-info">Élève</span>
                    </p>
                    <hr class="bg-white">
                    <nav class="nav flex-column">
                        <a class="nav-link active" href="/student/dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Tableau de bord
                        </a>
                        <hr class="bg-white">
                        <a class="nav-link text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                        </a>
                    </nav>
                </div>
            </div>
            
            <div class="col-md-10 p-4">
                <div class="welcome-banner">
                    <h2><i class="bi bi-emoji-smile"></i> Bonjour, <%= user.full_name %> !</h2>
                    <p class="mb-0">Bienvenue sur votre espace de suivi des notes EPS.</p>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card text-center p-3">
                            <h6 class="text-muted">Moyenne générale</h6>
                            <h2 class="<%= moyenne >= 10 ? 'text-success' : 'text-danger' %>"><%= moyenne %></h2>
                            <small>/20</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center p-3">
                            <h6 class="text-muted">Évaluations</h6>
                            <h2><%= evaluations.length %></h2>
                            <small>au total</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center p-3">
                            <h6 class="text-muted">Classe</h6>
                            <h5><%= student && student.class_name ? student.class_name : 'Non affecté' %></h5>
                        </div>
                    </div>
                </div>
                
                <!-- Évaluations avec saisie autorisée -->
<% if (pendingEvaluations && pendingEvaluations.length > 0) { %>
<div class="card mb-4">
    <div class="card-header bg-warning text-white py-3">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Saisie de mes performances</h5>
        <small>Cliquez sur "Saisir mes données" pour enregistrer vos performances</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Activité</th>
                        <th>Classe</th>
                        <th>Contrôle</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(var i = 0; i < pendingEvaluations.length; i++) { 
                        var eval = pendingEvaluations[i];
                        // Vérifier si l'élève a déjà saisi une note
                        var hasGrade = evaluations.some(e => e.id === eval.id);
                        var statusClass = hasGrade ? 'bg-success' : 'bg-secondary';
                        var statusText = hasGrade ? 'Déjà saisi' : 'À saisir';
                    %>
                    <tr>
                        <td><%= new Date(eval.evaluation_date).toLocaleDateString('fr-FR') %></td>
                        <td><strong><%= eval.aps_name %></strong></td>
                        <td><%= eval.class_name %></td>
                        <td>Contrôle <%= eval.control_number %></td>
                        <td><span class="badge <%= statusClass %>"><%= statusText %></span></td>
                        <td>
                            <a href="/student/input-evaluation/<%= eval.id %>" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Saisir mes données
                            </a>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<% } %>
                
                <!-- Résultats déjà obtenus -->
                <div class="card">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0"><i class="bi bi-table"></i> Mes résultats</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Activité</th>
                                        <th>Classe</th>
                                        <th>Contrôle</th>
                                        <th>Note /20</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (evaluations.length === 0) { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                Aucune évaluation pour le moment
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% for(var i = 0; i < evaluations.length; i++) { 
                                            var eval = evaluations[i];
                                            var noteClass = '';
                                            if (eval.total_score >= 15) noteClass = 'note-good';
                                            else if (eval.total_score >= 10) noteClass = 'note-medium';
                                            else noteClass = 'note-bad';
                                        %>
                                        <tr>
                                            <td><%= new Date(eval.evaluation_date).toLocaleDateString('fr-FR') %></td>
                                            <td><strong><%= eval.aps_name %></strong></td>
                                            <td><%= eval.class_name %></td>
                                            <td>Contrôle <%= eval.control_number %></td>
                                            <td class="<%= noteClass %>"><%= parseFloat(eval.total_score).toFixed(2) %> / 20</td>
                                            <td>
                                                <a href="/student/evaluation/<%= eval.id %>" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> Détail
                                                </a>
                                            </td>
                                        </tr>
                                        <% } %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>