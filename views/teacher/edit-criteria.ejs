<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurer <%= aps.name %> - EPS Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #2c3e50 0%, #1a2632 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 10px;
        }
        .sidebar .nav-link:hover {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }
        .criteria-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 p-0">
                <div class="sidebar p-3">
                    <h4 class="text-white text-center mb-4">
                        <i class="bi bi-trophy-fill"></i> EPS Manager
                    </h4>
                    <hr class="bg-white">
                    <p class="text-white-50 text-center small">
                        <i class="bi bi-person-circle"></i> <%= user.full_name %><br>
                        <span class="badge bg-info">Enseignant</span>
                    </p>
                    <hr class="bg-white">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/teacher/dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Tableau de bord
                        </a>
                        <a class="nav-link" href="/teacher/students">
                            <i class="bi bi-people me-2"></i> Gestion élèves
                        </a>
                        <a class="nav-link active" href="/teacher/criteria">
                            <i class="bi bi-sliders2 me-2"></i> Configurer critères
                        </a>
                        <a class="nav-link" href="/teacher/evaluations">
                            <i class="bi bi-clipboard-check me-2"></i> Évaluations
                        </a>
                        <hr class="bg-white">
                        <a class="nav-link text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                        </a>
                    </nav>
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2><i class="bi bi-gear-fill me-2"></i> Configurer : <%= aps.name %></h2>
                        <p class="text-muted mb-0">Définissez vos propres critères d'évaluation</p>
                    </div>
                    <a href="/teacher/criteria" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                </div>
                
                <% if (error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>
                
                <!-- Critères par défaut -->
<% if (aps.type === 'gymnastics') { %>
<div class="alert alert-info mb-4">
    <i class="bi bi-info-circle-fill me-2"></i>
    <strong>Critères par défaut pour la gymnastique :</strong><br>
    Valeurs : A = 0.75, B = 1.25, C = 1.75<br>
    Formule : Note = a*A + b*B + c*C (max 7 pts)
</div>
<% } else if (aps.type === 'sprint') { %>
<div class="alert alert-info mb-4">
    <i class="bi bi-info-circle-fill me-2"></i>
    <strong>Critères par défaut pour la course de vitesse :</strong><br>
    Filles (60m) : Note = -1 × temps + 14.9<br>
    Garçons (80m) : Note = -0.7 × temps + 13.4
</div>
<% } else if (aps.type === 'courselongue') { %>
<div class="alert alert-info mb-4">
    <i class="bi bi-info-circle-fill me-2"></i>
    <strong>Critères par défaut pour la course de durée :</strong><br>
    Filles (600m) : Note = -0.0416 × temps + 11.7<br>
    Garçons (1000m) : Note = -0.0375 × temps + 14.25
</div>
<% } %>
                
                <form action="/teacher/criteria/<%= aps.id %>" method="POST" id="criteriaForm">
                    <div id="criteria-container">
                        <% if (criteria && criteria.length > 0) { %>
                            <% for(var i = 0; i < criteria.length; i++) { 
                                var crit = criteria[i];
                            %>
                            <div class="criteria-card" data-id="<%= i %>">
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <label class="form-label">Nom du critère</label>
                                        <input type="text" 
                                               name="criteria_<%= i %>_name" 
                                               class="form-control crit-name" 
                                               value="<%= crit.name %>"
                                               required>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label">Note maximale</label>
                                        <input type="number" 
                                               name="criteria_<%= i %>_max_score" 
                                               class="form-control crit-max" 
                                               step="0.5" 
                                               min="0" 
                                               max="20"
                                               value="<%= crit.max_score %>">
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label">Type de formule</label>
                                        <select name="criteria_<%= i %>_formula_type" class="form-select crit-type">
                                            <option value="manual" <%= crit.formula_type === 'manual' ? 'selected' : '' %>>Manuelle</option>
                                            <option value="time" <%= crit.formula_type === 'time' ? 'selected' : '' %>>Basée sur le temps</option>
                                            <option value="difficulty" <%= crit.formula_type === 'difficulty' ? 'selected' : '' %>>Basée sur la difficulté</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label">&nbsp;</label>
                                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeCriteria(this)">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        <% } else { %>
                            <div class="criteria-card" data-id="0">
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <label class="form-label">Nom du critère</label>
                                        <input type="text" name="criteria_0_name" class="form-control crit-name" placeholder="Ex: Exécution technique" required>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label">Note maximale</label>
                                        <input type="number" name="criteria_0_max_score" class="form-control crit-max" step="0.5" min="0" max="20" value="20">
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label">Type de formule</label>
                                        <select name="criteria_0_formula_type" class="form-select crit-type">
                                            <option value="manual">Manuelle</option>
                                            <option value="time">Basée sur le temps</option>
                                            <option value="difficulty">Basée sur la difficulté</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label">&nbsp;</label>
                                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeCriteria(this)">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="mt-3 mb-4">
                        <button type="button" class="btn btn-outline-success" onclick="addCriteria()">
                            <i class="bi bi-plus-circle"></i> Ajouter un critère
                        </button>
                    </div>
                    
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save"></i> Sauvegarder les critères
                        </button>
                        <a href="/teacher/criteria" class="btn btn-secondary ms-2">
                            <i class="bi bi-x-circle"></i> Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script>
        let criteriaCount = <%= criteria ? criteria.length : 1 %>;
        
        function addCriteria() {
            const container = document.getElementById('criteria-container');
            const newId = criteriaCount;
            const newCard = document.createElement('div');
            newCard.className = 'criteria-card';
            newCard.setAttribute('data-id', newId);
            newCard.innerHTML = `
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Nom du critère</label>
                        <input type="text" name="criteria_${newId}_name" class="form-control crit-name" placeholder="Ex: ${getDefaultCriteriaName()}" required>
                    </div>
                    <div class="col-md-3 mb-2">
    <label class="form-label">Note maximale</label>
    <input type="number" name="criteria_<%= i %>_max_score" class="form-control" step="0.5" min="0" max="20" value="<%= crit.max_score %>">
</div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Type de formule</label>
                        <select name="criteria_${newId}_formula_type" class="form-select crit-type">
                            <option value="manual">Manuelle</option>
                            <option value="time">Basée sur le temps</option>
                            <option value="difficulty">Basée sur la difficulté</option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeCriteria(this)">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(newCard);
            criteriaCount++;
        }
        
        function getDefaultCriteriaName() {
            const names = ['Exécution', 'Technique', 'Créativité', 'Performance', 'Maîtrise', 'Précision'];
            return names[Math.floor(Math.random() * names.length)];
        }
        
        function removeCriteria(button) {
            button.closest('.criteria-card').remove();
        }
    </script>
</body>
</html>