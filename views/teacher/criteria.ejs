<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurer les critères - EPS Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #2c3e50 0%, #1a2632 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 12px 20px;
            margin: 5px 0;
            border-radius: 10px;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-3px);
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }
        .badge-criteria {
            background: #e9ecef;
            color: #495057;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 p-0">
                <div class="sidebar p-3">
                    <h4 class="text-white text-center mb-4">
                        <i class="bi bi-trophy-fill"></i> EPS Manager
                    </h4>
                    <hr class="bg-white">
                    <p class="text-white-50 text-center small">
                        <i class="bi bi-person-circle"></i> <%= user.full_name %><br>
                        <span class="badge bg-info">Enseignant</span>
                    </p>
                    <hr class="bg-white">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/teacher/dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Tableau de bord
                        </a>
                        <a class="nav-link" href="/teacher/students">
                            <i class="bi bi-people me-2"></i> Gestion élèves
                        </a>
                        <a class="nav-link active" href="/teacher/criteria">
                            <i class="bi bi-sliders2 me-2"></i> Configurer critères
                        </a>
                        <a class="nav-link" href="/teacher/evaluations">
                            <i class="bi bi-clipboard-check me-2"></i> Évaluations
                        </a>
                        <hr class="bg-white">
                        <a class="nav-link text-danger" href="/logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                        </a>
                    </nav>
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i class="bi bi-sliders2-fill me-2"></i> Configuration des critères</h2>
                </div>
                
                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Personnalisez vos critères d'évaluation</strong><br>
                    Pour chaque activité sportive, vous pouvez définir vos propres critères de notation.
                    Les critères par défaut sont déjà configurés, mais vous pouvez les modifier selon vos besoins.
                </div>
                
                <div class="row">
                    <% for(var i = 0; i < apsList.length; i++) { 
                        var aps = apsList[i];
                    %>
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="card-title mb-0">
                                        <i class="bi bi-trophy text-warning me-2"></i>
                                        <%= aps.name %>
                                    </h5>
                                    <span class="badge bg-secondary"><%= aps.type %></span>
                                </div>
                                
                                <div class="mb-3">
                                    <% if (aps.criteria && aps.criteria.length > 0) { %>
                                        <div class="small text-muted mb-2">Critères configurés :</div>
                                        <% for(var j = 0; j < aps.criteria.length; j++) { 
                                            var crit = aps.criteria[j];
                                        %>
                                            <div class="badge-criteria mb-1 d-inline-block me-1">
                                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                                <%= crit.name %> (max <%= crit.max_score %> pts)
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <div class="text-muted small">
                                            <i class="bi bi-info-circle"></i> Aucun critère personnalisé
                                        </div>
                                        <div class="text-muted small mt-1">
                                            <i class="bi bi-database"></i> Utilise les critères par défaut
                                        </div>
                                    <% } %>
                                </div>
                                
                                <a href="/teacher/criteria/<%= aps.id %>" class="btn btn-outline-primary btn-sm w-100">
                                    <i class="bi bi-gear"></i> Configurer les critères
                                </a>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>