<!DOCTYPE html>
<html>
<head>
    <title>Résultats</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .note-good { color: #28a745; font-weight: bold; }
        .note-medium { color: #ffc107; font-weight: bold; }
        .note-bad { color: #dc3545; font-weight: bold; }
        .criteria-detail {
            font-size: 0.85rem;
            color: #6c757d;
        }
        .table-criteria th, .table-criteria td {
            font-size: 0.85rem;
            padding: 0.5rem;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1><i class="bi bi-bar-chart-fill"></i> Résultats</h1>
                <p class="text-muted">
                    <strong><%= evaluation.class_name %></strong> - 
                    <%= evaluation.aps_name %> - 
                    Contrôle <%= evaluation.control_number %>
                </p>
            </div>
            <div>
                <a href="/teacher/evaluations/<%= evaluation.id %>/export" class="btn btn-success me-2">
                    <i class="bi bi-file-excel"></i> Exporter Excel
                </a>
                <a href="/teacher/evaluations" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>
        </div>
        
        <!-- Tableau principal avec détails des critères -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr class="text-center">
                        <th rowspan="2">#</th>
                        <th rowspan="2">Élève</th>
                        <th rowspan="2">Sexe</th>
                        <th colspan="<%= criteria.length %>" class="text-center">Détail des critères</th>
                        <th rowspan="2">Note /20</th>
                    </tr>
                    <tr class="text-center">
                        <% for(var j = 0; j < criteria.length; j++) { 
                            var crit = criteria[j];
                        %>
                        <th class="criteria-detail">
                            <%= crit.name %>
                            <br>
                            <small>(/<%= crit.max_score %>)</small>
                        </th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% if(grades.length === 0) { %>
                    <tr>
                        <td colspan="<%= 4 + criteria.length %>" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Aucune note pour cette évaluation
                        </td>
                    </tr>
                    <% } else { 
                        for(var i = 0; i < grades.length; i++) { 
                            var grade = grades[i];
                            var note = parseFloat(grade.total_score);
                            var noteClass = '';
                            if(note >= 15) noteClass = 'note-good';
                            else if(note >= 10) noteClass = 'note-medium';
                            else noteClass = 'note-bad';
                            
                            // Analyser les scores des critères
                            var criteriaScores = {};
                            if(grade.criteria_scores) {
                                criteriaScores = JSON.parse(grade.criteria_scores);
                            }
                    %>
                    <tr>
                        <td class="text-center"><%= i+1 %></td>
                        <td><strong><%= grade.full_name %></strong></td>
                        <td class="text-center">
                            <% if(grade.gender === 'M') { %>
                                <span class="badge bg-info">Garçon</span>
                            <% } else { %>
                                <span class="badge bg-warning">Fille</span>
                            <% } %>
                        </td>
                        <% for(var j = 0; j < criteria.length; j++) { 
                            var crit = criteria[j];
                            var score = 0;
                            
                            if(crit.is_preset === 1) {
                                // Critère pré-programmé
                                if(crit.formula_type === 'difficulty') {
                                    // Pour la gymnastique
                                    var a = criteriaScores[crit.id + '_A'] || 0;
                                    var b = criteriaScores[crit.id + '_B'] || 0;
                                    var c = criteriaScores[crit.id + '_C'] || 0;
                                    score = (a * 0.75) + (b * 1.25) + (c * 1.75);
                                } else if(crit.formula_type === 'time') {
                                    // Pour les courses
                                    score = criteriaScores[crit.id] || 0;
                                }
                            } else {
                                // Critère personnalisé
                                score = criteriaScores[crit.id] || 0;
                            }
                            
                            var scorePercent = (score / crit.max_score) * 100;
                            var barColor = scorePercent >= 70 ? 'bg-success' : (scorePercent >= 50 ? 'bg-warning' : 'bg-danger');
                        %>
                        <td class="text-center">
                            <div><%= score.toFixed(2) %></div>
                            <div class="progress mt-1" style="height: 5px;">
                                <div class="progress-bar <%= barColor %>" role="progressbar" style="width: <%= scorePercent %>%;"></div>
                            </div>
                        </td>
                        <% } %>
                        <td class="text-center <%= noteClass %>">
                            <strong><%= note.toFixed(2) %></strong> / 20
                        </td>
                    </tr>
                    <% } 
                    } %>
                </tbody>
            </table>
        </div>
        
        <!-- Statistiques -->
        <% if(grades.length > 0) { 
            var notes = [];
            for(var i = 0; i < grades.length; i++) {
                notes.push(parseFloat(grades[i].total_score));
            }
            var somme = 0;
            for(var i = 0; i < notes.length; i++) {
                somme += notes[i];
            }
            var moyenne = (somme / notes.length).toFixed(2);
            var maxNote = Math.max.apply(null, notes);
            var minNote = Math.min.apply(null, notes);
        %>
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card text-center bg-light">
                    <div class="card-body">
                        <h6 class="text-muted">Moyenne</h6>
                        <h3 class="text-primary"><%= moyenne %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-light">
                    <div class="card-body">
                        <h6 class="text-muted">Note max</h6>
                        <h3 class="text-success"><%= maxNote %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-light">
                    <div class="card-body">
                        <h6 class="text-muted">Note min</h6>
                        <h3 class="text-danger"><%= minNote %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-light">
                    <div class="card-body">
                        <h6 class="text-muted">Élèves</h6>
                        <h3><%= grades.length %></h3>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>
</body>
</html>