<!DOCTYPE html>
<html>
<head>
    <title>Mes évaluations</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
    <div class="container mt-5">
        <h1>Mes évaluations</h1>
        <a href="/teacher/evaluations/create" class="btn btn-primary mb-3">Nouvelle évaluation</a>
        
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Classe</th>
                    <th>Activité</th>
                    <th>Contrôle</th>
                    <th>Saisie élève</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for(var i = 0; i < evaluations.length; i++) { 
                    var evalItem = evaluations[i];
                %>
                <tr>
                    <td><%= evalItem.id %></td>
                    <td><%= new Date(evalItem.evaluation_date).toLocaleDateString('fr-FR') %></td>
                    <td><strong><%= evalItem.class_name %></strong></td>
                    <td><span class="badge bg-info"><%= evalItem.aps_name %></span></td>
                    <td>Contrôle <%= evalItem.control_number %></td>
                    <td class="text-center">
                        <form action="/teacher/toggle-student-input/<%= evalItem.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm <%= evalItem.student_can_input ? 'btn-success' : 'btn-secondary' %>">
                                <i class="bi bi-<%= evalItem.student_can_input ? 'toggle-on' : 'toggle-off' %>"></i>
                                <%= evalItem.student_can_input ? 'ON' : 'OFF' %>
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href="/teacher/evaluations/<%= evalItem.id %>/grade" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Saisir notes
                        </a>
                        <a href="/teacher/evaluations/<%= evalItem.id %>/view" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-eye"></i> Voir
                        </a>
                        <form action="/teacher/delete-evaluation/<%= evalItem.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Supprimer cette évaluation ? Toutes les notes seront perdues.')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
        
        <a href="/teacher/dashboard" class="btn btn-secondary">Retour</a>
    </div>
</body>
</html>