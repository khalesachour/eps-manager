<!DOCTYPE html>
<html>
<head>
    <title>Créer une évaluation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1>Créer une évaluation</h1>
        
        <form action="/teacher/evaluations/create" method="POST">
            <div class="mb-3">
                <label>Classe</label>
                <select name="class_id" class="form-control" required>
                    <option value="">Choisir</option>
                    <% for(var i = 0; i < classes.length; i++) { %>
                    <option value="<%= classes[i].id %>"><%= classes[i].name %></option>
                    <% } %>
                </select>
            </div>
            <div class="mb-3">
                <label>Activité</label>
                <select name="aps_id" class="form-control" required>
                    <option value="">Choisir</option>
                    <% for(var i = 0; i < apsList.length; i++) { %>
                    <option value="<%= apsList[i].id %>"><%= apsList[i].name %></option>
                    <% } %>
                </select>
            </div>
            <div class="mb-3">
                <label>Contrôle n°</label>
                <input type="number" name="control_number" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary">Créer</button>
            <a href="/teacher/evaluations" class="btn btn-secondary">Annuler</a>
        </form>
            <div class="mb-3">
              <div class="form-check">
                <input type="checkbox" name="student_can_input" class="form-check-input" value="1" id="studentInput">
                <label class="form-check-label" for="studentInput">
                  <i class="bi bi-person-check"></i> Permettre aux élèves de saisir leurs propres données
                </label>
                <small class="text-muted d-block">Les élèves pourront saisir leurs performances et notes pour cette évaluation</small>
        </div>
    </div>
</body>
</html>