<!DOCTYPE html>
<html>
<head>
    <title>Saisir les notes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .student-card {
            background: white;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .preset-criteria {
            background: #e8f4fd;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 10px;
        }
        .custom-criteria {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h1>Saisir les notes</h1>
        <p><strong><%= evaluation.class_name %></strong> - <%= evaluation.aps_name %> - Contrôle <%= evaluation.control_number %></p>
        <a href="/teacher/evaluations" class="btn btn-secondary mb-3">Retour</a>
        
        <form action="/teacher/evaluations/<%= evaluation.id %>/grade" method="POST">
            <% for(var i = 0; i < students.length; i++) { 
                var student = students[i];
                var existing = gradesMap[student.id] || {};
                var existingScores = existing.criteria_scores || {};
            %>
            <div class="student-card">
                <h4><%= student.full_name %> (ID: <%= student.id %>)</h4>
                <p class="text-muted">N° <%= student.student_number %> - <%= student.gender === 'M' ? 'Garçon' : 'Fille' %></p>
                
                <% if (allCriteria && allCriteria.length > 0) { %>
                    
                    <!-- Critères pré-programmés -->
                    <% for(var j = 0; j < allCriteria.length; j++) { 
                        var crit = allCriteria[j];
                        if (crit.is_preset === 1) { %>
                            <div class="preset-criteria">
                                <strong><%= crit.name %> (max <%= crit.max_score %> pts)</strong>
                                <% if (crit.formula_type === 'difficulty') { %>
                                <div class="row mt-2">
                                    <div class="col-4">
                                        <label>Éléments A (0.75 pt)</label>
                                        <input type="number" name="grades[student_<%= student.id %>][<%= crit.id %>_A]" class="form-control gym-input" data-student="<%= student.id %>" step="1" min="0" value="<%= existingScores[crit.id + '_A'] || 0 %>">
                                    </div>
                                    <div class="col-4">
                                        <label>Éléments B (1.25 pt)</label>
                                        <input type="number" name="grades[student_<%= student.id %>][<%= crit.id %>_B]" class="form-control gym-input" data-student="<%= student.id %>" step="1" min="0" value="<%= existingScores[crit.id + '_B'] || 0 %>">
                                    </div>
                                    <div class="col-4">
                                        <label>Éléments C (1.75 pt)</label>
                                        <input type="number" name="grades[student_<%= student.id %>][<%= crit.id %>_C]" class="form-control gym-input" data-student="<%= student.id %>" step="1" min="0" value="<%= existingScores[crit.id + '_C'] || 0 %>">
                                    </div>
                                </div>
                                <% } else if (crit.formula_type === 'time') { %>
                                <div class="row mt-2">
                                    <div class="col-md-6">
                                        <label>Temps (secondes)</label>
                                        <input type="number" name="grades[student_<%= student.id %>][time]" class="form-control time-input" data-student="<%= student.id %>" step="0.01" placeholder="Ex: 12.5" value="<%= existingScores.time || '' %>">
                                    </div>
                                </div>
                                <% } %>
                            </div>
                        <% } 
                    } %>
                    
                    <!-- Critères personnalisés -->
                    <div class="custom-criteria mt-3">
                        <strong>Critères supplémentaires :</strong>
                        <div class="row mt-2">
                            <% for(var j = 0; j < allCriteria.length; j++) { 
                                var crit = allCriteria[j];
                                if (crit.is_preset === 0) { 
                                    var critVal = existingScores[crit.id] || 0;
                                %>
                                <div class="col-md-3 mb-2">
                                    <label><%= crit.name %> (max <%= crit.max_score %> pts)</label>
                                    <input type="number" name="grades[student_<%= student.id %>][criteria_<%= crit.id %>]" class="form-control custom-input" data-student="<%= student.id %>" step="0.5" min="0" max="<%= crit.max_score %>" value="<%= critVal %>">
                                </div>
                                <% } 
                            } %>
                        </div>
                    </div>
                <% } %>
                
                <div class="mt-2">
                    <label><strong>Note finale /20 :</strong></label>
                    <input type="text" id="total_score_<%= student.id %>" class="form-control" style="width: 100px; display: inline-block; font-weight: bold; color: #28a745;" readonly value="<%= existing.total_score || '0' %>">
                    <input type="hidden" name="grades[student_<%= student.id %>][total_score]" id="total_hidden_<%= student.id %>" value="<%= existing.total_score || '0' %>">
                </div>
            </div>
            <% } %>
            
            <button type="submit" class="btn btn-primary mt-3">Sauvegarder les notes</button>
        </form>
    </div>
    
    <script>
        var ids = <%= JSON.stringify(students.map(s => s.id)) %>;
        var allCriteria = <%= JSON.stringify(allCriteria) %>;
        
        console.log('IDs des élèves:', ids);
        console.log('Tous les critères:', allCriteria);
        
        function calculerNoteTotale(studentId) {
            var total = 0;
            
            for(var k = 0; k < allCriteria.length; k++) {
                var crit = allCriteria[k];
                var score = 0;
                
                if (crit.is_preset === 1) {
                    if (crit.formula_type === 'difficulty') {
                        var a = parseFloat(document.querySelector('input[name="grades[student_' + studentId + '][' + crit.id + '_A]"]')?.value) || 0;
                        var b = parseFloat(document.querySelector('input[name="grades[student_' + studentId + '][' + crit.id + '_B]"]')?.value) || 0;
                        var c = parseFloat(document.querySelector('input[name="grades[student_' + studentId + '][' + crit.id + '_C]"]')?.value) || 0;
                        score = (a * 0.75) + (b * 1.25) + (c * 1.75);
                        score = Math.min(score, crit.max_score);
                        console.log('  Difficulté: A=' + a + ', B=' + b + ', C=' + c + ' -> score=' + score);
                    }
                } 
                else {
                    var input = document.querySelector('input[name="grades[student_' + studentId + '][criteria_' + crit.id + ']"]');
                    score = parseFloat(input ? input.value : 0) || 0;
                    score = Math.min(score, crit.max_score);
                    console.log('  ' + crit.name + ': score=' + score);
                }
                
                total += score;
            }
            
            total = Math.min(total, 20);
            var totalInput = document.getElementById('total_score_' + studentId);
            var totalHidden = document.getElementById('total_hidden_' + studentId);
            if (totalInput) totalInput.value = total.toFixed(2);
            if (totalHidden) totalHidden.value = total.toFixed(2);
            console.log('  TOTAL pour ' + studentId + ': ' + total.toFixed(2));
        }
        
        for(var i = 0; i < ids.length; i++) {
            var id = ids[i];
            var inputs = document.querySelectorAll('input.gym-input[data-student="' + id + '"], input.custom-input[data-student="' + id + '"], input.time-input[data-student="' + id + '"]');
            for(var j = 0; j < inputs.length; j++) {
                inputs[j].addEventListener('input', (function(iid) {
                    return function() { calculerNoteTotale(iid); };
                })(id));
            }
            calculerNoteTotale(id);
        }
    </script>
</body>
</html>